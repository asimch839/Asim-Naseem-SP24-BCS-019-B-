rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaffOrAbove(businessId) {
      return isAuthenticated();
    }

    match /businesses/{businessId}/{allPaths=**} {
      // Allow read/write to authenticated users belonging to the system
      allow read: if isAuthenticated();
      // Allow uploads under 20MB
      allow write: if isAuthenticated() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
